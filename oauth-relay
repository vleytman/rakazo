#!/usr/bin/env python3
"""Loopback relay for MCP OAuth sign-ins to a tailnet-only Rakazo.

Some OAuth providers (Upwork) only send the browser back to known domains or to localhost.
The server is set up with MCP_OAUTH_REDIRECT_ORIGIN=http://localhost:33419, and this relay
forwards http://localhost:33419/mcp/oauth/callback?... to the same path on the web origin.

  ./oauth-relay                 run in the foreground
  ./oauth-relay install         keep it running in the background (macOS launchd)
  ./oauth-relay uninstall
"""
import http.server, os, subprocess, sys
from urllib.parse import urlsplit

PORT = int(os.environ.get("RELAY_PORT", "33419"))
TARGET = os.environ.get("RAKAZO_WEB_ORIGIN", "https://rakazo.tail555d59.ts.net").rstrip("/")
LABEL = "com.rakazo.oauth-relay"
PLIST = os.path.expanduser(f"~/Library/LaunchAgents/{LABEL}.plist")


class Relay(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        path = urlsplit(self.path)
        if path.path != "/mcp/oauth/callback":
            self.send_error(404)
            return
        self.send_response(302)
        self.send_header("Location", f"{TARGET}{path.path}{'?' + path.query if path.query else ''}")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def log_message(self, *args):
        pass


def install():
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    with open(PLIST, "w") as f:
        f.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>{os.path.abspath(__file__)}</string></array>
  <key>EnvironmentVariables</key><dict><key>RAKAZO_WEB_ORIGIN</key><string>{TARGET}</string><key>RELAY_PORT</key><string>{PORT}</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
</dict></plist>
""")
    subprocess.run(["launchctl", "unload", PLIST], capture_output=True)
    subprocess.run(["launchctl", "load", PLIST], check=True)
    print(f"relay on http://localhost:{PORT} → {TARGET} (launchd: {LABEL})")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "install":
        install()
    elif cmd == "uninstall":
        subprocess.run(["launchctl", "unload", PLIST], capture_output=True)
        if os.path.exists(PLIST):
            os.remove(PLIST)
        print("removed")
    else:
        http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Relay).serve_forever()
